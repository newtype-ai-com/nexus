# Self-hosted Nexus configuration. Copy to .env (chmod 600) and fill in.
# Never commit .env. Generate every secret yourself on the server; nothing
# here is a real value. Empty means "not set" (the feature stays off).
#
# Secret generation (run once, paste the output):
#   POSTGRES_PASSWORD       openssl rand -hex 32
#   SEAL_MASTER             openssl rand -base64 32
#   DELEGATION_SIGNING_KEY  openssl rand -base64 32
#   ADMIN_TOKEN             openssl rand -hex 32

# ---------------------------------------------------------------- required
# Database password for the bundled postgres (hex only: it goes into a URL).
POSTGRES_PASSWORD=

# Your public HTTPS origin, no path, no trailing slash. Clients enrol here,
# approval mail links point here. Example: https://nexus.example.com
BASE_URL=

# ------------------------------------------------- owner and enrolment (mail)
# The owner. Every owner feature (adding users, quota approval, approvals
# mail) follows this one address; empty = no owner features.
# Mail-free owner start (NEXUS_OWNER_CODE=1 below): `docker compose run --rm
# enrol-owner` prints a one-time code for `newtype auth enrol --code`
# (docs/selfhost.md §4-A). Mail is
# still needed for anyone else and goes through the Resend HTTP API only; for a
# mail-free owner-only start put any placeholder in RESEND_API_KEY/MAIL_FROM.
# Resend test sender onboarding@resend.dev can only mail the address that owns
# the Resend account; use a verified domain for anyone else.
NEXUS_OWNER_EMAIL=
# With NEXUS_OWNER_EMAIL set, ENROL_ALLOW must be exactly that same address.
# Without an owner, ENROL_ALLOW is a comma list of exact addresses and/or bare
# domains (example.com admits anyone@example.com).
ENROL_ALLOW=
# 1 = only the owner may hold credentials (strict single-person server).
NEXUS_OWNER_ONLY=1
# 1 = allow the operator's one-time owner code (nexus enrol-owner). Off by
# default in Nexus; the hosted lic.newtype-ai.com does not enable it.
# Needs NEXUS_OWNER_EMAIL: set 0 on a server without an owner.
NEXUS_OWNER_CODE=1
RESEND_API_KEY=
MAIL_FROM=
# Optional operator token for POST /v1/enrol/revoke (credential revocation).
ADMIN_TOKEN=

# ------------------------------------------------------------- sealing
# Signs delegations and receipts and seals stored secrets. Set all four
# together. SEAL_ISSUER is your public HTTPS origin (same as BASE_URL).
# Losing SEAL_MASTER makes sealed values unreadable: back it up offline.
SEAL_MASTER=
DELEGATION_SIGNING_KEY=
SIGNING_KID=selfhost-v1
SEAL_ISSUER=

# ------------------------------------------------- remote MCP (optional)
# Serves Claude Code / claude.ai at ${NEXUS_MCP_ISSUER}/mcp with OAuth.
# Must be your public HTTPS origin (http only for a loopback IP).
NEXUS_MCP_ISSUER=

# ----------------------------------------------- model relay (optional)
# Off by default: every person can bring their own model profile in the
# client (/model add). Set these only to relay one shared upstream model.
# An OpenAI-compatible full URL (…/chat/completions or …/responses).
MODEL_UPSTREAM=
MODEL_API_KEY=
# Comma list of model names clients may ask for.
MODEL_NAMES=
# Per-session token ceiling and per-call output limit (positive integers).
MODEL_TOKEN_CEILING=
MODEL_MAX_OUTPUT=
# Optional: MODEL_TURN_TIMEOUT_SECONDS (1..900), MODEL_CALL_BUDGET_FILE
# (/data/call-budget.jsonl), MODEL_OWNER_TOKEN_CEILING, MODEL_OWNER_MAX_OUTPUT.
# Azure AI Foundry instead of MODEL_UPSTREAM/MODEL_API_KEY:
#   MS_FOUNDRY_PROJECT_ENDPOINT=  MS_FOUNDRY_API_KEY=  MODEL_PROTOCOL=

# ------------------------------------------------------ other (optional)
# Signed client releases directory inside the container (404 when unset).
NEXUS_RELEASES_DIR=
# Database timeouts in milliseconds.
NEXUS_DB_STATEMENT_TIMEOUT_MS=60000
NEXUS_DB_LOCK_TIMEOUT_MS=5000
# Private schema name (never "public").
NEXUS_DB_SCHEMA=nexus
# Loopback host port for the nexus HTTP listener (compose only).
NEXUS_HTTP_PORT=8080
# Public DNS name for the optional Caddy TLS profile (no scheme).
NEXUS_DOMAIN=
